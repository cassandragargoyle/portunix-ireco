{
  "$schema": "https://cassandragargoyle.example/ireco/config-1.0.json",
  "version": 1,
  "doc_types": ["invoice"],
  "io": {
    "input_dir": "./in",
    "output_dir": "./out"
  },
  "invoice": {
    "tenancy": "multitenant",
    "extraction": {
      "depth": "items",
      "orders": {
        "source": "local",
        "path": "./orders/*.json"
      }
    }
  }
}
