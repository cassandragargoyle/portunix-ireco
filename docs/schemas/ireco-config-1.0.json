{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cassandragargoyle.example/ireco/config-1.0.json",
  "title": "ireco.config.json (v1)",
  "description": "Per-directory configuration for the ptx-ireco pipeline. See ADR-0004 and issue #002.",
  "type": "object",
  "required": ["version", "doc_types", "io"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Config schema version. Must be 1 for this document."
    },
    "doc_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["invoice", "receipt", "delivery_note", "purchase_order"]
      },
      "description": "Document types processed in this directory. Only 'invoice' is implemented; others are reserved."
    },
    "io": {
      "type": "object",
      "required": ["input_dir", "output_dir"],
      "additionalProperties": false,
      "properties": {
        "input_dir": {
          "type": "string",
          "minLength": 1
        },
        "output_dir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invoice": {
      "type": "object",
      "required": ["tenancy"],
      "additionalProperties": false,
      "properties": {
        "tenancy": {
          "type": "string",
          "enum": ["multitenant", "known"]
        },
        "extraction": {
          "$ref": "#/$defs/extraction"
        },
        "recipients": {
          "type": "array",
          "items": {"$ref": "#/$defs/recipient"}
        }
      }
    },
    "watcher": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional settings consumed by ptx-ireco-watcher. Absent → defaults.",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["local", "cli", "grpc"],
          "description": "Dispatch backend. 'local' = in-process call; 'cli' = subprocess; 'grpc' = reserved."
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "description": "Pool size for ProcessPoolExecutor. 1 = sequential."
        },
        "cooldown_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds to wait after file creation before dispatching."
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "Glob patterns matched against detected file names."
        },
        "recursive": {
          "type": "boolean",
          "description": "Watch subdirectories recursively."
        },
        "post_process": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["export-isdoc"]
          },
          "description": "Handlers chained after scan.processed (issue 006). Currently only 'export-isdoc' is recognised; future handlers extend the enum."
        },
        "post_process_options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "export-isdoc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "format": {"type": "string", "enum": ["isdoc", "isdocx"]},
                "profile": {"type": "string", "enum": ["minimal", "standard", "full"]},
                "allow_incomplete": {"type": "boolean"},
                "output_dir": {"type": "string", "minLength": 1},
                "source_pdf": {"type": "string", "minLength": 1}
              }
            }
          },
          "description": "Per-handler options keyed by handler name."
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional location of the models tree. Absent → the current working directory is the root (models in ./models/invoice/).",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute or relative path to the directory containing models/invoice/. A relative path is anchored at the directory of the config file."
        }
      }
    },
    "parse": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional settings for step 1 (PDF → .vim.json). Added by issue 007.",
      "properties": {
        "ocr": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-page OCR fallback knobs. Defaults mirror OcrOptions in ptx_ireco.pipeline.parse.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Master switch for OCR. Default: false (no plugin import)."
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "description": "Tesseract language code(s), '+'-separated (e.g. 'eng', 'eng+ces')."
            },
            "dpi": {
              "type": "integer",
              "minimum": 72,
              "description": "Page render DPI used for the OCR pass."
            },
            "min_ink_ratio": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "description": "Blank-page guard. Pages whose non-white pixel ratio falls below this value are skipped before Tesseract is invoked."
            },
            "mode": {
              "type": "string",
              "enum": ["printed"],
              "description": "OCR mode. Only 'printed' is supported in v1; handwritten/checkbox are reserved for follow-ups."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "extraction": {
      "type": "object",
      "required": ["depth"],
      "additionalProperties": false,
      "properties": {
        "depth": {
          "type": "string",
          "enum": ["header", "items"]
        },
        "orders": {
          "type": "object",
          "required": ["source", "path"],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "enum": ["local"]
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "recipient": {
      "type": "object",
      "required": ["id", "name", "ico", "extraction"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Kebab-case slug, unique within the file."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ico": {
          "type": "string",
          "pattern": "^[0-9]{8}$",
          "description": "8-digit Czech IČO (checksum not enforced in v1)."
        },
        "dic": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9A-Z]+$"
        },
        "extraction": {"$ref": "#/$defs/extraction"}
      }
    }
  }
}
